# URL del backend (apps/api).
#
# Vacio (recomendado en desarrollo): las llamadas a /auth y /health salen
# como rutas relativas y las reenvia el proxy de Vite (ver vite.config.ts)
# hacia http://localhost:3000. Esto mantiene todo en el mismo origen desde
# el navegador, lo cual es necesario para que la cookie de sesion funcione
# si el frontend se expone con un tunel (ngrok/Cloudflare) para pruebas
# remotas, y tambien funciona igual de bien en local puro.
VITE_API_URL=

# Alternativa: apuntar directo al backend (sin usar el proxy de Vite).
# VITE_API_URL=http://localhost:3000
