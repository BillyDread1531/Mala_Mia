/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model returns {
  id                       BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  sale_id                  BigInt           @db.UnsignedBigInt
  return_number            String           @unique(map: "uq_returns_number") @db.VarChar(50)
  return_date              DateTime         @default(now()) @db.DateTime(0)
  reason                   String           @db.VarChar(255)
  refund_amount            Decimal          @default(0.00) @db.Decimal(12, 2)
  refund_payment_method_id BigInt?          @db.UnsignedBigInt
  status                   String           @default("COMPLETED") @db.VarChar(30)
  notes                    String?          @db.Text
  created_by               BigInt           @db.UnsignedBigInt
  created_at               DateTime         @default(now()) @db.DateTime(0)
  return_items             return_items[]
  payment_methods          payment_methods? @relation(fields: [refund_payment_method_id], references: [id], onDelete: Restrict, map: "fk_returns_payment_method")
  sales                    sales            @relation(fields: [sale_id], references: [id], map: "fk_returns_sale")
  users                    users            @relation(fields: [created_by], references: [id], map: "fk_returns_user")

  @@index([refund_payment_method_id], map: "fk_returns_payment_method")
  @@index([created_by], map: "fk_returns_user")
  @@index([return_date], map: "idx_returns_date")
  @@index([sale_id], map: "idx_returns_sale")
