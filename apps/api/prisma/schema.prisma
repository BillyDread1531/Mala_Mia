/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// Corrección de un error humano al registrar una línea de venta (talla,
/// color, cantidad o precio equivocados). A diferencia de una devolución o
/// un cambio, SÍ actualiza sale_items para reflejar lo que realmente se
/// vendió; esta tabla conserva el valor anterior como historial auditable.
model sale_corrections {
  id                  BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  sale_id             BigInt     @db.UnsignedBigInt
  sale_item_id        BigInt     @db.UnsignedBigInt
  correction_number   String     @unique(map: "uq_sale_corrections_number") @db.VarChar(50)
  previous_size_id    BigInt     @db.UnsignedBigInt
  previous_color_id   BigInt     @db.UnsignedBigInt
  previous_quantity   Int
  previous_unit_price Decimal    @db.Decimal(12, 2)
  new_size_id         BigInt     @db.UnsignedBigInt
  new_color_id        BigInt     @db.UnsignedBigInt
  new_quantity        Int
  new_unit_price      Decimal    @db.Decimal(12, 2)
  reason              String     @db.VarChar(255)
  notes               String?    @db.Text
  created_by          BigInt     @db.UnsignedBigInt
  created_at          DateTime   @default(now()) @db.DateTime(0)
  sales               sales      @relation(fields: [sale_id], references: [id], map: "fk_sale_corrections_sale")
  sale_items          sale_items @relation(fields: [sale_item_id], references: [id], map: "fk_sale_corrections_sale_item")
  previous_size       sizes      @relation("sale_corrections_previous_size", fields: [previous_size_id], references: [id], map: "fk_sale_corrections_prev_size")
  previous_color      colors     @relation("sale_corrections_previous_color", fields: [previous_color_id], references: [id], map: "fk_sale_corrections_prev_color")
  new_size            sizes      @relation("sale_corrections_new_size", fields: [new_size_id], references: [id], map: "fk_sale_corrections_new_size")
  new_color           colors     @relation("sale_corrections_new_color", fields: [new_color_id], references: [id], map: "fk_sale_corrections_new_color")
  users               users      @relation(fields: [created_by], references: [id], map: "fk_sale_corrections_user")

  @@index([sale_id], map: "idx_sale_corrections_sale")
  @@index([sale_item_id], map: "idx_sale_corrections_sale_item")
  @@index([previous_size_id], map: "fk_sale_corrections_prev_size")
  @@index([previous_color_id], map: "fk_sale_corrections_prev_color")
  @@index([new_size_id], map: "fk_sale_corrections_new_size")
  @@index([new_color_id], map: "fk_sale_corrections_new_color")
  @@index([created_by], map: "fk_sale_corrections_user")
}

model sale_items {
