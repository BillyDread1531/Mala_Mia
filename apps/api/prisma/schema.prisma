model receipts {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  sale_id        BigInt   @unique(map: "uq_receipts_sale") @db.UnsignedBigInt
  receipt_number String   @unique(map: "uq_receipts_number") @db.VarChar(50)
  generated_at   DateTime @default(now()) @db.DateTime(0)
  sales          sales    @relation(fields: [sale_id], references: [id], map: "fk_receipts_sale")
