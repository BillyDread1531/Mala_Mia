  id               BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  return_id        BigInt     @db.UnsignedBigInt
  sale_item_id     BigInt     @db.UnsignedBigInt
  quantity         Int
  condition_status String     @db.VarChar(20)
  notes            String?    @db.Text
  returns          returns    @relation(fields: [return_id], references: [id], map: "fk_return_items_return")
  sale_items       sale_items @relation(fields: [sale_item_id], references: [id], map: "fk_return_items_sale_item")

  @@index([return_id], map: "idx_return_items_return")
