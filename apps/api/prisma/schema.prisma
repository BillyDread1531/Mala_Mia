  reinvestment_amount     Decimal  @default(0.00) @db.Decimal(12, 2)
  reserve_amount          Decimal  @default(0.00) @db.Decimal(12, 2)
  created_at              DateTime @default(now()) @db.DateTime(0)

  @@unique([week_start, week_end], map: "uq_profit_distribution_week")
  @@index([week_start, week_end], map: "idx_profit_distribution_week")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model profit_distribution_settings {
  id                      BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  personal_percentage     Decimal  @default(50.00) @db.Decimal(5, 2)
  reinvestment_percentage Decimal  @default(30.00) @db.Decimal(5, 2)
  reserve_percentage      Decimal  @default(20.00) @db.Decimal(5, 2)
  updated_by              BigInt?  @db.UnsignedBigInt
  created_at              DateTime @default(now()) @db.DateTime(0)
  updated_at              DateTime @default(now()) @db.DateTime(0)
  users                   users?   @relation(fields: [updated_by], references: [id], map: "fk_profit_distribution_updated_by")

  @@index([updated_by], map: "fk_profit_distribution_updated_by")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
