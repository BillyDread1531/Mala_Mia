generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model app_settings {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  setting_key   String   @unique(map: "uq_app_settings_key") @db.VarChar(100)
  setting_value String   @db.VarChar(500)
  setting_group String   @db.VarChar(50)
  description   String?  @db.VarChar(255)
  updated_by    BigInt?  @db.UnsignedBigInt
  created_at    DateTime @default(now()) @db.DateTime(0)
  updated_at    DateTime @default(now()) @db.DateTime(0)
  users         users?   @relation(fields: [updated_by], references: [id], map: "fk_app_settings_user")

  @@index([updated_by], map: "fk_app_settings_user")
  @@index([setting_group], map: "idx_app_settings_group")
}

model audit_logs {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt   @db.UnsignedBigInt
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(100)
  entity_id   BigInt?  @db.UnsignedBigInt
  old_values  Json?
  new_values  Json?
  reason      String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.DateTime(0)
  users       users    @relation(fields: [user_id], references: [id], map: "fk_audit_logs_user")

  @@index([action], map: "idx_audit_action")
  @@index([created_at], map: "idx_audit_date")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
  @@index([user_id], map: "idx_audit_user")
}

model business_settings {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  business_name   String   @default("MALA MÍA") @db.VarChar(150)
  logo_url        String?  @db.VarChar(500)
  phone           String?  @db.VarChar(50)
  whatsapp        String?  @db.VarChar(50)
  instagram       String?  @db.VarChar(150)
  facebook        String?  @db.VarChar(150)
  address         String?  @db.VarChar(500)
  receipt_message String?  @db.VarChar(500)
  created_at      DateTime @default(now()) @db.DateTime(0)
  updated_at      DateTime @default(now()) @db.DateTime(0)
}

model categories {
  id         BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  name       String     @unique(map: "uq_categories_name") @db.VarChar(100)
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now()) @db.DateTime(0)
  updated_at DateTime   @default(now()) @db.DateTime(0)
  products   products[]
}

model consumables {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name                String   @unique(map: "uq_consumables_name") @db.VarChar(100)
  quantity            Int      @default(0)
  low_stock_threshold Int      @default(5)
  units_per_sale      Int      @default(1)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @db.DateTime(0)
  updated_at          DateTime @default(now()) @db.DateTime(0)
}

model colors {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  name             String             @db.VarChar(100)
  normalized_name  String             @unique(map: "uq_colors_normalized_name") @db.VarChar(100)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.DateTime(0)
  updated_at       DateTime           @default(now()) @db.DateTime(0)
  exchange_items   exchange_items[]
  inventory_items  inventory_items[]
  product_colors   product_colors[]
  product_variants product_variants[]
  purchase_items   purchase_items[]
  sale_items       sale_items[]
  sale_corrections_previous sale_corrections[] @relation("sale_corrections_previous_color")
  sale_corrections_new      sale_corrections[] @relation("sale_corrections_new_color")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model exchange_items {
  id                    BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  exchange_id           BigInt          @db.UnsignedBigInt
  movement_direction    String          @db.VarChar(20)
  original_sale_item_id BigInt?         @db.UnsignedBigInt
  product_id            BigInt          @db.UnsignedBigInt
  inventory_item_id     BigInt          @db.UnsignedBigInt
  size_id               BigInt          @db.UnsignedBigInt
  color_id              BigInt          @db.UnsignedBigInt
  quantity              Int
  historical_unit_price Decimal         @db.Decimal(12, 2)
  unit_cost             Decimal         @db.Decimal(12, 2)
  colors                colors          @relation(fields: [color_id], references: [id], map: "fk_exchange_items_color")
  exchanges             exchanges       @relation(fields: [exchange_id], references: [id], map: "fk_exchange_items_exchange")
  inventory_items       inventory_items @relation(fields: [inventory_item_id], references: [id], map: "fk_exchange_items_inventory")
  sale_items            sale_items?     @relation(fields: [original_sale_item_id], references: [id], map: "fk_exchange_items_original_sale_item")
  products              products        @relation(fields: [product_id], references: [id], map: "fk_exchange_items_product")
  sizes                 sizes           @relation(fields: [size_id], references: [id], map: "fk_exchange_items_size")

  @@index([color_id], map: "fk_exchange_items_color")
  @@index([original_sale_item_id], map: "fk_exchange_items_original_sale_item")
  @@index([product_id], map: "fk_exchange_items_product")
  @@index([size_id], map: "fk_exchange_items_size")
  @@index([exchange_id], map: "idx_exchange_items_exchange")
  @@index([inventory_item_id], map: "idx_exchange_items_inventory")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model exchanges {
  id                   BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  original_sale_id     BigInt           @db.UnsignedBigInt
  exchange_number      String           @unique(map: "uq_exchanges_number") @db.VarChar(50)
  exchange_date        DateTime         @default(now()) @db.DateTime(0)
  difference_amount    Decimal          @default(0.00) @db.Decimal(12, 2)
  difference_direction String           @default("NONE") @db.VarChar(20)
  payment_method_id    BigInt?          @db.UnsignedBigInt
  notes                String?          @db.Text
  created_by           BigInt           @db.UnsignedBigInt
  created_at           DateTime         @default(now()) @db.DateTime(0)
  exchange_items       exchange_items[]
  payment_methods      payment_methods? @relation(fields: [payment_method_id], references: [id], onDelete: Restrict, map: "fk_exchanges_payment_method")
  sales                sales            @relation(fields: [original_sale_id], references: [id], map: "fk_exchanges_sale")
  users                users            @relation(fields: [created_by], references: [id], map: "fk_exchanges_user")

  @@index([payment_method_id], map: "fk_exchanges_payment_method")
  @@index([created_by], map: "fk_exchanges_user")
  @@index([exchange_date], map: "idx_exchanges_date")
  @@index([original_sale_id], map: "idx_exchanges_sale")
}

model expense_categories {
  id         BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  name       String     @unique(map: "uq_expense_categories_name") @db.VarChar(100)
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now()) @db.DateTime(0)
  updated_at DateTime   @default(now()) @db.DateTime(0)
  expenses   expenses[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expenses {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  category_id        BigInt             @db.UnsignedBigInt
  description        String             @db.VarChar(255)
  amount             Decimal            @db.Decimal(12, 2)
  expense_date       DateTime           @default(now()) @db.DateTime(0)
  payment_method_id  BigInt             @db.UnsignedBigInt
  notes              String?            @db.Text
  status             String             @default("COMPLETED") @db.VarChar(30)
  created_by         BigInt             @db.UnsignedBigInt
  created_at         DateTime           @default(now()) @db.DateTime(0)
  updated_at         DateTime           @default(now()) @db.DateTime(0)
  expense_categories expense_categories @relation(fields: [category_id], references: [id], map: "fk_expenses_category")
  payment_methods    payment_methods    @relation(fields: [payment_method_id], references: [id], map: "fk_expenses_payment_method")
  users              users              @relation(fields: [created_by], references: [id], map: "fk_expenses_user")

  @@index([payment_method_id], map: "fk_expenses_payment_method")
  @@index([created_by], map: "fk_expenses_user")
  @@index([category_id], map: "idx_expenses_category")
  @@index([expense_date], map: "idx_expenses_date")
  @@index([status], map: "idx_expenses_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model financial_movements {
  id                BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  movement_type     String           @db.VarChar(40)
  direction         String           @db.VarChar(10)
  amount            Decimal          @db.Decimal(12, 2)
  payment_method_id BigInt?          @db.UnsignedBigInt
  reference_type    String?          @db.VarChar(50)
  reference_id      BigInt?          @db.UnsignedBigInt
  description       String           @db.VarChar(255)
  movement_date     DateTime         @default(now()) @db.DateTime(0)
  created_by        BigInt           @db.UnsignedBigInt
  created_at        DateTime         @default(now()) @db.DateTime(0)
  payment_methods   payment_methods? @relation(fields: [payment_method_id], references: [id], map: "fk_financial_payment_method")
  users             users            @relation(fields: [created_by], references: [id], map: "fk_financial_user")

  @@index([payment_method_id], map: "fk_financial_payment_method")
  @@index([created_by], map: "fk_financial_user")
  @@index([movement_date], map: "idx_financial_date")
  @@index([reference_type, reference_id], map: "idx_financial_reference")
  @@index([movement_type], map: "idx_financial_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_items {
  id                    BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  product_id            BigInt                @db.UnsignedBigInt
  size_id               BigInt                @db.UnsignedBigInt
  color_id              BigInt                @db.UnsignedBigInt
  quantity              Int                   @default(0)
  average_cost          Decimal               @default(0.00) @db.Decimal(12, 2)
  is_available_for_sale Boolean               @default(true)
  created_at            DateTime              @default(now()) @db.DateTime(0)
  updated_at            DateTime              @default(now()) @db.DateTime(0)
  exchange_items        exchange_items[]
  colors                colors                @relation(fields: [color_id], references: [id], map: "fk_inventory_color")
  products              products              @relation(fields: [product_id], references: [id], map: "fk_inventory_product")
  sizes                 sizes                 @relation(fields: [size_id], references: [id], map: "fk_inventory_size")
  inventory_movements   inventory_movements[]
  sale_items            sale_items[]

  @@unique([product_id, size_id, color_id], map: "uq_inventory_combination")
  @@index([color_id], map: "fk_inventory_color")
  @@index([size_id], map: "fk_inventory_size")
  @@index([is_available_for_sale], map: "idx_inventory_available")
  @@index([product_id], map: "idx_inventory_product")
  @@index([quantity], map: "idx_inventory_stock")
}

model inventory_movements {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  inventory_item_id BigInt          @db.UnsignedBigInt
  movement_type     String          @db.VarChar(40)
  quantity          Int
  quantity_before   Int
  quantity_after    Int
  unit_cost         Decimal?        @db.Decimal(12, 2)
  reference_type    String?         @db.VarChar(50)
  reference_id      BigInt?         @db.UnsignedBigInt
  reason            String?         @db.VarChar(255)
  notes             String?         @db.Text
  created_by        BigInt          @db.UnsignedBigInt
  created_at        DateTime        @default(now()) @db.DateTime(0)
  inventory_items   inventory_items @relation(fields: [inventory_item_id], references: [id], map: "fk_inventory_movements_item")
  users             users           @relation(fields: [created_by], references: [id], map: "fk_inventory_movements_user")

  @@index([created_by], map: "fk_inventory_movements_user")
  @@index([created_at], map: "idx_inventory_movements_date")
  @@index([inventory_item_id], map: "idx_inventory_movements_item")
  @@index([reference_type, reference_id], map: "idx_inventory_movements_reference")
  @@index([movement_type], map: "idx_inventory_movements_type")
}

model payment_methods {
  id                   BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String                @unique(map: "uq_payment_methods_name") @db.VarChar(50)
  applies_to_sales     Boolean               @default(true)
  applies_to_purchases Boolean               @default(true)
  applies_to_expenses  Boolean               @default(true)
  is_active            Boolean               @default(true)
  created_at           DateTime              @default(now()) @db.DateTime(0)
  updated_at           DateTime              @default(now()) @db.DateTime(0)
  exchanges            exchanges[]
  expenses             expenses[]
  financial_movements  financial_movements[]
  purchases            purchases[]
  returns              returns[]
  sales                sales[]
}

model product_colors {
  product_id BigInt   @db.UnsignedBigInt
  color_id   BigInt   @db.UnsignedBigInt
  colors     colors   @relation(fields: [color_id], references: [id], map: "fk_product_colors_color")
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_product_colors_product")

  @@id([product_id, color_id])
  @@index([color_id], map: "fk_product_colors_color")
}

model product_sizes {
  product_id BigInt   @db.UnsignedBigInt
  size_id    BigInt   @db.UnsignedBigInt
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_product_sizes_product")
  sizes      sizes    @relation(fields: [size_id], references: [id], map: "fk_product_sizes_size")

  @@id([product_id, size_id])
  @@index([size_id], map: "fk_product_sizes_size")
}

model products {
  id                    BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  category_id           BigInt             @db.UnsignedBigInt
  code                  String             @unique(map: "uq_products_code") @db.VarChar(50)
  name                  String             @db.VarChar(150)
  description           String?            @db.Text
  cost                  Decimal?           @db.Decimal(12, 2)
  sale_price            Decimal?           @db.Decimal(12, 2)
  /// Medidas opcionales (cm), usadas principalmente en pantalones.
  waist_measurement     Decimal?           @db.Decimal(6, 2)
  length_measurement    Decimal?           @db.Decimal(6, 2)
  is_available_for_sale Boolean            @default(true)
  created_at            DateTime           @default(now()) @db.DateTime(0)
  updated_at            DateTime           @default(now()) @db.DateTime(0)
  exchange_items        exchange_items[]
  inventory_items       inventory_items[]
  product_colors        product_colors[]
  product_sizes         product_sizes[]
  product_variants      product_variants[]
  categories            categories         @relation(fields: [category_id], references: [id], map: "fk_products_category")
  purchase_items        purchase_items[]
  sale_items            sale_items[]

  @@index([is_available_for_sale], map: "idx_products_available")
  @@index([category_id], map: "idx_products_category")
  @@index([name], map: "idx_products_name")
}

/// Combinacion talla+color que un producto declara manejar. NO implica
/// existencias: eso lo registra `inventory_items` cuando exista una compra.
model product_variants {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  product_id BigInt   @db.UnsignedBigInt
  size_id    BigInt   @db.UnsignedBigInt
  color_id   BigInt   @db.UnsignedBigInt
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @db.DateTime(0)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_product_variants_product")
  sizes      sizes    @relation(fields: [size_id], references: [id], map: "fk_product_variants_size")
  colors     colors   @relation(fields: [color_id], references: [id], map: "fk_product_variants_color")

  @@unique([product_id, size_id, color_id], map: "uq_product_variants_combination")
  @@index([size_id], map: "fk_product_variants_size")
  @@index([color_id], map: "fk_product_variants_color")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model profit_distribution_periods {
  id                      BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  week_start              DateTime @db.Date
  week_end                DateTime @db.Date
  real_profit             Decimal  @default(0.00) @db.Decimal(12, 2)
  personal_percentage     Decimal  @db.Decimal(5, 2)
  reinvestment_percentage Decimal  @db.Decimal(5, 2)
  reserve_percentage      Decimal  @db.Decimal(5, 2)
