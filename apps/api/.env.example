# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Puerto donde escucha la API
PORT=3000

# Cadena de conexion a MySQL (base de datos existente "mala_mia", NO recrear)
# Formato: mysql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL="mysql://usuario:contrasena@localhost:3306/mala_mia"

# Solo para (re)sembrar usuarios reales con `npx prisma db seed`.
# NO se guardan aqui: se pasan inline en la terminal el momento de sembrar, ej.:
#   SEED_PASSWORD_ANDREA=xxxx SEED_PASSWORD_BILLY=xxxx npx prisma db seed
# Si la variable no esta definida, ese usuario se omite (no se crea ni se toca).
